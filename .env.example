# Telegram
BOT_TOKEN=your_bot_token_here

# Database (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./teahouse.db

# Redis (optional, memory fallback included)
REDIS_URL=redis://localhost:6379/0

# Google Gemini (10 ta API key vergul bilan)
GEMINI_API_KEYS=your_gemini_keys_separated_by_comma
GEMINI_MODEL=gemini-3.1-flash-lite

# App
TIMEZONE=Asia/Tashkent
MEETING_PRICE_UZS=99000
MIN_TABLE_SIZE=3
MAX_TABLE_SIZE=4
PAYMENT_WINDOW_MINUTES=60

# Admin
ADMIN_SECRET_KEY=change_this_to_random_secret
ADMIN_PORT=8000
